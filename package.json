{
  "name": "last-call",
  "version": "2.0.0",
  "private": true,
  "description": "A two-player co-operative puzzle game set in an abandoned telephone exchange: 200 stages, one Caller, one Operator.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test \"test/browser/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "admin:setup": "node scripts/admin-setup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0"
  },
  "license": "UNLICENSED"
}
