# Example settings for Last Call. Every value here is optional.
# For local use, copy this file to .env (it is git-ignored) and edit it.
# On a host such as Render, set these in the dashboard instead.
# Never commit a real .env file, a real API key or a real SAVE_SECRET.

# HTTP port and bind address. Hosts usually set PORT for you.
PORT=3000
HOST=0.0.0.0

# Set to 1 when running behind a reverse proxy or a platform like Render,
# Railway or Fly, so rate limits see the real client IP (X-Forwarded-For)
# and HTTPS is detected. Leave at 0 when nothing sits in front of the server.
TRUST_PROXY=0

# Optional, with TRUST_PROXY=1: a header your proxy sets to the real client IP
# and that clients cannot forge through it. On Render (behind Cloudflare) use
# cf-connecting-ip; on Fly.io, fly-client-ip. Leave unset otherwise.
# CLIENT_IP_HEADER=cf-connecting-ip

# Public address used in link previews (WhatsApp and others) and invite links.
# Render sets RENDER_EXTERNAL_URL automatically; set this for a custom domain.
# PUBLIC_URL=https://last-call.example.com

# Signs the saved progress and room tickets kept in players' browsers, so
# progress and rooms survive restarts. Use 32+ random characters, for example
# the output of:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it stable: changing it makes every saved game unreadable.
# SAVE_SECRET=

# Optional folder for full room persistence: chat and stages in progress
# survive restarts. Must be on a persistent disk on your host.
# DATA_DIR=./data

# Log detail: debug, info, warn or error.
LOG_LEVEL=info

# Optional comma-separated list of extra origins allowed to open the game's
# WebSocket (the page's own origin is always allowed).
# ALLOWED_ORIGINS=https://your-game.example.com

# Rooms close after this many minutes with nobody connected...
ROOM_IDLE_MINUTES=30
# ...and always close after this many hours.
ROOM_MAX_HOURS=4

# Optional: the Exchange narrator writes one short atmospheric line per
# completed stage using the Claude API. Off by default; the game is complete
# without it. The key stays on the server and is never sent to browsers.
# Both ENABLE_AI_NARRATOR=true and ANTHROPIC_API_KEY are needed to turn it on.
ENABLE_AI_NARRATOR=false
# ANTHROPIC_API_KEY=your-api-key-here
# Defaults to claude-opus-5-5. Any current Claude model ID works here.
# ANTHROPIC_MODEL=claude-opus-5-5
